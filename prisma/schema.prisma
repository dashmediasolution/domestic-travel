generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

enum PackageType {
    REGULAR
    SPECIAL
    UPCOMMING
}

enum PackageOccasion {
    NONE
    CHRISTMAS
    DIWALI
    NEW_YEAR
    VALENTINE
    HOLI
    EID
    SUMMER
    WINTER
    FESTIVAL
    OTHER
}

enum OfferType {
    REGULAR
    EARLY_BIRD
    FLASH_SALE
    SEASONAL
    FESTIVE
    LIMITED_TIME
    SPECIAL
}

enum BannerTargetType {
    DESTINATION
    PACKAGE
    OFFER
    CUSTOM_URL
}

type PackageImage {
    url      String
    publicId String?
}

type BlogImage {
    url      String
    publicId String
}

type ItineraryDay {
    day         Int
    title       String
    description String?
    activities  String[]
    meals       String[]
    overnight   String?
}

model AdminUser {
    id           String  @id @default(auto()) @map("_id") @db.ObjectId
    name         String
    email        String  @unique
    passwordHash String
    isActive     Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

