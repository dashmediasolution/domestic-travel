model Destination {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    slug String @unique

    // NEW: Parent-child destination hierarchy
    parentId String?       @db.ObjectId
    parent   Destination?  @relation("DestinationHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    children Destination[] @relation("DestinationHierarchy")

    subtitle    String?
    description String?
    faqs        FAQ[]
    location    String?
    idealTrip   String?
    budget      String?

    activities      String[]
    bestTimeToVisit String[]

    heroImage PackageImage?
    gallery   PackageImage[]

    metaTitle       String?
    metaDescription String?
    keywords        String[]

    isPublished Boolean @default(false)
    isFeatured  Boolean @default(false)

    publishedAt DateTime?

    whyVisit Json?

    packages    Package[]
    attractions Attraction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Package {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    slug String
    faqs FAQ[]

    category String

    type     PackageType     @default(REGULAR)
    occasion PackageOccasion @default(NONE)

    destinationId String      @db.ObjectId
    destination   Destination @relation(fields: [destinationId], references: [id])

    parentId String?   @db.ObjectId
    parent   Package?  @relation("PackageHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    children Package[] @relation("PackageHierarchy")

    subtitle    String?
    description String?

    location  String?
    latitude  Float?
    longitude Float?

    duration  String?
    groupSize String?

    idealTrip       String?
    budget          String?
    bestTimeToVisit String[]
    badge         String?
    originalPrice Float
    rating       Float?
    reviewsCount Int?

    highlights String[]
    inclusions String[]
    exclusions String[]

    whyVisit Json?

    heroImage PackageImage?
    gallery   PackageImage[]

    travelInformation Json?
    whatToPack        String[]

    itinerary ItineraryDay[]

    metaTitle       String?
    metaDescription String?
    keywords        String[]

    isPublished Boolean @default(false)
    isFeatured  Boolean @default(false)

    publishedAt DateTime?

    offers Offer[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
 
    @@unique([destinationId, slug])
}

model Attraction {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name        String
    description String

    imageUrl String
    publicId String?

    destinationId String      @db.ObjectId
    destination   Destination @relation(fields: [destinationId], references: [id])

    isPublished Boolean @default(true)
    sortOrder   Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([destinationId, name])
}

model Offer {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    title String
    slug  String @unique

    type OfferType

    description String?

    packageId String  @db.ObjectId
    package   Package @relation(fields: [packageId], references: [id])

    originalPrice Float?
    offerPrice    Float
    discount      Float?
    saveAmount    Float?

    startDate DateTime
    endDate   DateTime

    isActive   Boolean @default(true)
    isFeatured Boolean @default(false)

    badgeText String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Banner {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    title String

    imageUrl String
    publicId String
    altText  String?

    targetType BannerTargetType
    targetUrl  String

    isActive   Boolean @default(true)
    isFeatured Boolean @default(false)

    startDate DateTime?
    endDate   DateTime?

    sortOrder Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive, sortOrder])
    @@index([isFeatured, isActive])
    @@index([targetType])
    @@index([startDate, endDate])
}

model Blog {
    id      String  @id @default(auto()) @map("_id") @db.ObjectId
    title   String
    slug    String  @unique
    excerpt String?
    content String

    featuredImage BlogImage?

    categoryId String?       @db.ObjectId
    category   BlogCategory? @relation(fields: [categoryId], references: [id])

    tags     String[]
    keywords String[]

    isPublished Boolean   @default(false)
    publishedAt DateTime?

    metaTitle       String?
    metaDescription String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model BlogCategory {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String @unique

    blogs Blog[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Inquiry {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    name    String
    phone   String
    email   String
    message String

    status InquiryStatus @default(NEW)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([createdAt])
}

enum InquiryStatus {
    NEW
    CONTACTED
    RESOLVED
    CLOSED
}

model FAQ {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    question String
    answer   String

    sortOrder Int @default(0)

    destinationId String? @db.ObjectId
    packageId     String? @db.ObjectId

    destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
    package     Package?     @relation(fields: [packageId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([destinationId])
    @@index([packageId])
    @@index([sortOrder])
}